generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────

enum ProjectStatus {
  green
  yellow
  red
}

enum TaskStatus {
  todo
  in_progress
  done
  blocked
}

enum ProjectTier {
  T1
  T2
  T3
  CIP
}

enum DemandSource {
  company_policy
  external_requirement
  internal_demand
  self_proposal
}

enum TeamRole {
  R
  A
  C
  I
  P
  S
}

enum UserRole {
  pm
  member
  executive
  admin
}

enum Priority {
  low
  medium
  high
}

enum RiskImpact {
  low
  medium
  high
}

enum ProjectPhase {
  draft
  active
}

enum RiskProbability {
  low
  medium
  high
}

enum RiskStatus {
  open
  mitigated
  closed
}

enum DelayRequestStatus {
  pending
  approved
  rejected
}

enum DelayRequestType {
  delay
  date_change
}

enum WeeklyUpdateStatus {
  on_time
  delay
}

enum NotificationType {
  task_assigned
  delay_submitted
  delay_approved
  delay_rejected
  task_overdue
  support_needed
  weekly_upload_missing
  weekly_report_ready
}

// ─── Models ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role         UserRole @default(member)
  jobTitle     String   @default("") @map("job_title")
  organization String   @default("")
  avatarUrl    String?  @map("avatar_url")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  ownedProjects       Project[]           @relation("ProjectOwner")
  teamMemberships     ProjectTeamMember[]
  weeklyUpdates       WeeklyUpdate[]
  delayRequests       DelayRequest[]      @relation("DelayRequester")
  reviewedDelays      DelayRequest[]      @relation("DelayReviewer")
  resolvedDelays      DelayRequest[]      @relation("DelaySupportResolver")
  delayReviewDecisions DelayReviewDecision[]
  taskLogs            TaskLog[]
  notifications       Notification[]
  drafts              ProjectDraft[]
  shareLinks          ShareLink[]
  memberWeeklyReports MemberWeeklyReport[]

  @@map("users")
}

model Project {
  id              String        @id @default(cuid())
  projectCode     String        @unique @map("project_code")
  projectType     String        @db.VarChar(100) @map("project_type")
  projectTier     ProjectTier?  @map("project_tier")
  demandSource    DemandSource? @map("demand_source")
  name            String
  // VarChar(1000): has @default(""), MySQL TEXT cannot have DEFAULT value
  objective       String        @default("") @db.VarChar(1000) @map("objective")
  purpose         String        @default("") @db.VarChar(1000)
  scope           String        @default("") @db.VarChar(1000)
  roi             String        @default("") @db.VarChar(1000)
  roiGrossMargin  Float?        @map("roi_gross_margin")
  roiAvgPrice     Float?        @map("roi_avg_price")
  roiCapacity     Float?        @map("roi_capacity")
  createdReason   String        @default("") @db.VarChar(1000) @map("created_reason")
  // Nullable TEXT: no DEFAULT needed, NULL is implicit
  expectedBenefits String?      @db.Text @map("expected_benefits")

  // SMART Objective (nullable TEXT: no DEFAULT needed)
  smartSpecific   String?       @db.Text @map("smart_specific")
  smartMeasurable String?       @db.Text @map("smart_measurable")
  smartAchievable String?       @db.Text @map("smart_achievable")
  smartRelevant   String?       @db.Text @map("smart_relevant")
  smartTimeBound  String?       @db.Text @map("smart_time_bound")

  startDate       DateTime      @map("start_date")
  endDate         DateTime      @map("end_date")
  phase           ProjectPhase  @default(draft)
  status          ProjectStatus @default(green)
  progress        Int           @default(0)
  budget          Float         @default(0)
  budgetUsed      Float         @default(0) @map("budget_used")

  ownerId         String        @map("owner_id")
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id])

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  teamMembers     ProjectTeamMember[]
  milestones      Milestone[]
  baselines       MilestoneBaseline[]
  tasks           Task[]
  risks           Risk[]
  weeklyUpdates   WeeklyUpdate[]
  delayRequests   DelayRequest[]
  taskLogs        TaskLog[]
  notifications   Notification[]
  shareLinks      ShareLink[]
  budgetItems     ProjectBudgetItem[]
  capexItems      CapexItem[]
  memberWeeklyReports MemberWeeklyReport[]

  @@index([startDate, endDate])
  @@map("projects")
}

model ProjectTeamMember {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  userId         String   @map("user_id")
  role           TeamRole
  jobTitle       String   @default("") @map("job_title")
  organization   String   @default("")
  responsibility String   @default("") @db.VarChar(500)

  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_team_members")
}

model Milestone {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  name      String
  startDate DateTime?  @map("start_date")
  dueDate   DateTime   @map("due_date")
  status    TaskStatus @default(todo)
  progress  Int        @default(0)
  sortOrder Int        @default(0) @map("sort_order")
  // 方案 A：true = 使用者手動覆寫日期（解鎖加寬），不再自動貼齊任務 envelope
  manualDates Boolean  @default(false) @map("manual_dates")

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relations
  tasks              Task[]
  baselines          MilestoneBaseline[]
  milestoneUpdates   MilestoneUpdate[]
  affectedMilestones AffectedMilestone[]
  memberWeeklyReports MemberWeeklyReport[]

  @@index([projectId, sortOrder])
  @@map("milestones")
}

model MilestoneBaseline {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  milestoneId String   @map("milestone_id")
  name        String
  dueDate     DateTime @map("due_date")
  baselinedAt DateTime @default(now()) @map("baselined_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([milestoneId])
  @@map("milestone_baselines")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String     @map("project_id")
  milestoneId String     @map("milestone_id")
  title       String
  description String     @default("") @db.VarChar(1000)
  assignee    String     @default("")
  status      TaskStatus @default(todo)
  priority    Priority   @default(medium)
  startDate      DateTime   @map("start_date")
  endDate        DateTime   @map("end_date")
  durationDays   Int        @default(0) @map("duration_days")
  progress       Int        @default(0)
  sortOrder      Int        @default(0) @map("sort_order")
  // 指派時刻：R 從「被 A 指派的那一刻」起才在週報看到此任務（與任務起訖無關）。
  // 重新指派給別人時會更新為當下；預設 now() 讓新任務與現有任務都有值。
  assignedAt  DateTime   @default(now()) @map("assigned_at")
  completedAt DateTime?  @map("completed_at")
  completedBy String?    @map("completed_by")
  // R（執行者）自我回報「此任務已完成／無後續進度」— 與 A 正式標記完成(completedAt)是不同定義。
  // R 按下後不再被催填週報；A 端會看到「R 回報完成待確認」提示，由 A 決定是否按下正式完成。
  reportedDoneAt DateTime? @map("reported_done_at")
  reportedDoneBy String?   @map("reported_done_by")
  // A 審核通過 R 的回報（認可內容、發布紀錄），但「不代表任務 100% 完成」— 完成與否另由 A 決定。
  reviewedAt  DateTime?  @map("reviewed_at")
  reviewedBy  String?    @map("reviewed_by")
  originalStartDate DateTime? @map("original_start_date")
  originalEndDate   DateTime? @map("original_end_date")
  parentId    String?    @map("parent_id")
  // 方案 A：true = 使用者手動覆寫日期（解鎖加寬），不再自動貼齊子任務 envelope
  manualDates Boolean    @default(false) @map("manual_dates")

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  parent      Task?      @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]     @relation("TaskSubtasks")

  // Self-referential many-to-many for dependencies
  dependsOn   TaskDependency[] @relation("DependentTask")
  dependedBy  TaskDependency[] @relation("PrerequisiteTask")

  taskLogs      TaskLog[]
  delayRequests DelayRequest[]
  reviewEvents  TaskReviewEvent[]

  @@index([projectId, milestoneId, sortOrder])
  @@index([assignee])
  @@index([status])
  @@index([parentId])
  @@map("tasks")
}

model TaskDependency {
  dependentId    String @map("dependent_id")
  prerequisiteId String @map("prerequisite_id")

  dependent      Task   @relation("DependentTask", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisite   Task   @relation("PrerequisiteTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([dependentId, prerequisiteId])
  @@index([prerequisiteId])
  @@map("task_dependencies")
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  projectId String   @map("project_id")
  authorId  String   @map("author_id")
  logDate   DateTime @map("log_date")
  content   String   @db.Text
  nextPlans   String?  @db.Text @map("next_plans")   // JSON: [{date?: string, content: string}]
  attachments String?  @db.Text                       // JSON: [{name, url, type: 'image'|'file'}]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  lastEditedBy String? @map("last_edited_by")          // 最後編輯者姓名（建立者見 author）
  // 由當責 A 審核後「發布」到官方更新紀錄的時間；null = R 尚未經 A 發布（不進更新紀錄）
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")
  // true = A 撰寫的「報告敘述」(進更新紀錄，但不驅動進度；進度由標記完成/延期決定)
  reportOnly  Boolean   @default(false) @map("report_only")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([projectId])
  @@map("task_logs")
}

// 任務審視歷程（輕量軌跡）：R 回報/取消、A 確認/退回，讓 A 可追蹤狀態變化。
model TaskReviewEvent {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  projectId String   @map("project_id")
  type      String   // reported(R回報) | cancelled(R取消) | confirmed(A確認完成) | rejected(A退回)
  actor     String   @default("")
  note      String?  @db.VarChar(500)   // 駁回原因等備註
  createdAt DateTime @default(now()) @map("created_at")

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@map("task_review_events")
}

// A（當責）撰寫的週報彙整說明：per 專案 + 週別 + 任務（taskId="" 代表專案層總彙整）。
// 官方「更新紀錄」= A 送出的彙整說明 + 被 A 納入(發布)的 R 紀錄。
model WeeklyReportNote {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  weekOf    String   @map("week_of")            // 週一 YYYY-MM-DD
  taskId    String   @default("") @map("task_id") // "" = 專案層總彙整；否則為該任務(常為父任務)的彙整說明
  content   String   @db.Text
  author    String   @default("")
  submittedAt DateTime? @map("submitted_at")     // A 送出時間；null = 尚未送出（草稿）
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([projectId, weekOf, taskId])
  @@index([projectId, weekOf])
  @@map("weekly_report_notes")
}

model Risk {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  title       String
  description String          @default("") @db.VarChar(1000)
  impact      RiskImpact      @default(medium)
  probability RiskProbability @default(medium)
  mitigation  String          @default("") @db.VarChar(1000)
  status      RiskStatus      @default(open)

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("risks")
}

model WeeklyUpdate {
  id               String             @id @default(cuid())
  projectId        String             @map("project_id")
  weekOf           DateTime           @map("week_of")
  updatedById      String             @map("updated_by_id")
  overallStatus    WeeklyUpdateStatus @default(on_time) @map("overall_status")
  overallNotes     String             @default("") @db.VarChar(1000) @map("overall_notes")
  blockers         String             @default("") @db.VarChar(1000)
  nextWeekPlan     String             @default("") @db.VarChar(1000) @map("next_week_plan")
  keyAchievements  String             @default("") @db.VarChar(1000) @map("key_achievements")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updatedBy        User               @relation(fields: [updatedById], references: [id])

  milestoneUpdates MilestoneUpdate[]

  @@index([projectId, weekOf])
  @@map("weekly_updates")
}

model MilestoneUpdate {
  id             String       @id @default(cuid())
  weeklyUpdateId String       @map("weekly_update_id")
  milestoneId    String       @map("milestone_id")
  progress       Int          @default(0)
  notes          String       @default("") @db.VarChar(1000)

  weeklyUpdate   WeeklyUpdate @relation(fields: [weeklyUpdateId], references: [id], onDelete: Cascade)
  milestone      Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([weeklyUpdateId])
  @@index([milestoneId])
  @@map("milestone_updates")
}

model DelayRequest {
  id                   String             @id @default(cuid())
  projectId            String             @map("project_id")
  requesterId          String             @map("requester_id")
  reason               String             @db.Text
  canCatchUp           Boolean            @default(false) @map("can_catch_up")
  supportNeeded        String             @default("") @db.VarChar(1000) @map("support_needed")
  type                 DelayRequestType   @default(delay)
  status               DelayRequestStatus @default(pending)
  reviewerId           String?            @map("reviewer_id")
  reviewedAt           DateTime?          @map("reviewed_at")
  reviewNotes          String?            @db.Text @map("review_notes")
  supportResolved      Boolean?           @map("support_resolved")
  supportResolvedAt    DateTime?          @map("support_resolved_at")
  supportResolvedById  String?            @map("support_resolved_by_id")
  supportResolvedNotes String?            @db.Text @map("support_resolved_notes")
  taskId               String?            @map("task_id")
  pendingTaskChanges   Json?              @map("pending_task_changes")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester            User               @relation("DelayRequester", fields: [requesterId], references: [id])
  reviewer             User?              @relation("DelayReviewer", fields: [reviewerId], references: [id])
  supportResolvedBy    User?              @relation("DelaySupportResolver", fields: [supportResolvedById], references: [id])
  task                 Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)

  affectedMilestones   AffectedMilestone[]
  reviewDecisions      DelayReviewDecision[]

  requiredReviewers    Int          @default(0) @map("required_reviewers")

  @@index([projectId])
  @@index([requesterId])
  @@index([taskId])
  @@map("delay_requests")
}

model AffectedMilestone {
  id             String       @id @default(cuid())
  delayRequestId String       @map("delay_request_id")
  milestoneId    String       @map("milestone_id")
  originalDate      DateTime  @map("original_date")
  proposedDate      DateTime  @map("proposed_date")
  originalStartDate DateTime? @map("original_start_date")
  proposedStartDate DateTime? @map("proposed_start_date")

  delayRequest   DelayRequest @relation(fields: [delayRequestId], references: [id], onDelete: Cascade)
  milestone      Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([delayRequestId])
  @@index([milestoneId])
  @@map("affected_milestones")
}

model DelayReviewDecision {
  id              String       @id @default(cuid())
  delayRequestId  String       @map("delay_request_id")
  reviewerId      String       @map("reviewer_id")
  action          String       // 'approve' | 'reject'
  notes           String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")

  delayRequest    DelayRequest @relation(fields: [delayRequestId], references: [id], onDelete: Cascade)
  reviewer        User         @relation(fields: [reviewerId], references: [id])

  @@unique([delayRequestId, reviewerId])
  @@index([delayRequestId])
  @@index([reviewerId])
  @@map("delay_review_decisions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  read      Boolean          @default(false)
  projectId String?          @map("project_id")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([projectId])
  @@map("notifications")
}

model ProjectDraft {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  mode      String   // 'manual' | 'ai'
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("project_drafts")
}

model ShareLink {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  token       String   @unique
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([projectId])
  @@index([token])
  @@map("share_links")
}

model ProjectBudgetItem {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  station       String   @default("") // 站別
  vendor        String   @default("") // 廠商
  equipment     String   @default("") // 設備機型/名稱
  quantity      Int      @default(1)  // 組數
  purchaseType  String   @default("") @map("purchase_type") // 選購方式
  unitPrice     Float?   @map("unit_price")      // 預估單價
  estimatedCost Float?   @map("estimated_cost") // 預估費用（= 單價 × 組數）
  actualCost    Float?   @map("actual_cost")    // 實際費用
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  capexItems    CapexItem[]

  @@index([projectId, sortOrder])
  @@map("project_budget_items")
}

model ProjectCodeSequence {
  id          String      @id @default(cuid())
  projectType String      @db.VarChar(100) @map("project_type")
  year        Int
  lastSeq     Int         @default(0) @map("last_seq")

  @@unique([projectType, year])
  @@map("project_code_sequences")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model NotificationProfile {
  id              String       @id @default(cuid())
  projectTier     ProjectTier? @unique @map("project_tier")
  frequencyWeeks  Int          @default(1) @map("frequency_weeks")
  dayOfWeek       Int          @default(5) @map("day_of_week")
  hour            Int          @default(9)
  notifyTitle     String?      @map("notify_title")
  notifyMessage   String?      @map("notify_message") @db.Text
  uploadedTitle   String?      @map("uploaded_title")
  uploadedMessage String?      @map("uploaded_message") @db.Text
  emailSubject    String?      @map("email_subject")
  emailBody       String?      @map("email_body") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("notification_profiles")
}

model MilestoneTemplateConfig {
  id           String   @id @default(cuid())
  projectType  String   @map("project_type")
  sortOrder    Int      @default(0) @map("sort_order")
  name         String
  durationDays Int      @default(14) @map("duration_days")
  tasks        MilestoneTemplateTask[]

  @@index([projectType, sortOrder])
  @@map("milestone_template_configs")
}

model MilestoneTemplateTask {
  id                  String   @id @default(cuid())
  milestoneTemplateId String   @map("milestone_template_id")
  parentId            String?  @map("parent_id")
  sortOrder           Int      @default(0) @map("sort_order")
  title               String
  durationDays        Int      @default(1) @map("duration_days")
  priority            String   @default("medium")

  milestoneTemplate   MilestoneTemplateConfig @relation(fields: [milestoneTemplateId], references: [id], onDelete: Cascade)
  parent              MilestoneTemplateTask?  @relation("TemplateTaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children            MilestoneTemplateTask[] @relation("TemplateTaskTree")

  @@index([milestoneTemplateId, sortOrder])
  @@index([parentId])
  @@map("milestone_template_tasks")
}

model ProjectTypeConfig {
  key        String   @id @db.VarChar(100)
  label      String   @db.VarChar(100)
  codePrefix String?  @db.VarChar(10) @map("code_prefix")
  isBuiltIn  Boolean  @default(false) @map("is_built_in")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("project_type_configs")
}

model CronJobLog {
  id            String   @id @default(cuid())
  jobType       String   @db.VarChar(50)
  runAt         DateTime @default(now()) @map("run_at")
  status        String   @db.VarChar(20)
  summary       String?  @db.Text
  affectedCount Int      @default(0) @map("affected_count")

  @@index([jobType, runAt])
  @@map("cron_job_logs")
}

model CapexItem {
  id                    String    @id @default(cuid())
  projectId             String    @map("project_id")
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetItemId          String?   @map("budget_item_id")
  budgetItem            ProjectBudgetItem? @relation(fields: [budgetItemId], references: [id], onDelete: SetNull)

  equipmentCategory     String    @default("") @map("equipment_category")
  station               String    @default("")
  supplier              String    @default("")
  issueDate             DateTime? @map("issue_date")
  poNumber              String    @default("") @map("po_number")
  partNumber            String    @default("") @map("part_number")
  masterSummary         String    @default("") @map("master_summary")
  partDescription       String    @default("") @map("part_description")
  unit                  String    @default("")
  currency              String    @default("TWD")
  quantity              Int       @default(1)
  originalPrice         Float?    @map("original_price")
  twdPrice              Float?    @map("twd_price")
  orderAmount           Float?    @map("order_amount")
  deliveryDate          DateTime? @map("delivery_date")
  bpmAcceptanceDate     DateTime? @map("bpm_acceptance_date")
  depositPct            Float?    @map("deposit_pct")
  deliveryPct           Float?    @map("delivery_pct")
  acceptancePct         Float?    @map("acceptance_pct")
  depositAmount         Float?    @map("deposit_amount")
  depositPayDate        DateTime? @map("deposit_pay_date")
  deliveryAmount        Float?    @map("delivery_amount")
  deliveryPayDate       DateTime? @map("delivery_pay_date")
  acceptanceAmount      Float?    @map("acceptance_amount")
  acceptancePayDate     DateTime? @map("acceptance_pay_date")
  paymentStatus         String    @default("") @map("payment_status")
  sortOrder             Int       @default(0) @map("sort_order")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([projectId, sortOrder])
  @@map("capex_items")
}

model MemberWeeklyReport {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  milestoneId String    @map("milestone_id")
  userId      String    @map("user_id")
  weekOf      DateTime  @map("week_of")
  content     String    @db.Text
  progress    Int       @default(0)
  blockers    String    @default("") @db.VarChar(1000)
  nextPlan    String    @default("") @db.VarChar(1000) @map("next_plan")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@unique([projectId, milestoneId, userId, weekOf])
  @@index([projectId, weekOf])
  @@index([userId])
  @@map("member_weekly_reports")
}
